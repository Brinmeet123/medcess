# Copy to .env.local for local development.

# PostgreSQL (required for Vercel and production — SQLite cannot run on serverless).
# Free options: Supabase (https://supabase.com), Neon (https://neon.tech), Vercel Postgres.
#
# --- Supabase (recommended) ---
# 1) Create a project → Project Settings → Database.
# 2) Open **Connect** → pick **URI** → paste the real **database password** (not the anon API key).
#    If the URL still shows `[YOUR-PASSWORD]`, replace that placeholder or copy a fresh string from the dashboard.
# 3) Passwords with symbols (`@ # % &` etc.) must be **URL-encoded** inside the URI or the connection will fail.
# 4) **Vercel build (`prisma migrate deploy`)** needs valid credentials. If the log shows **P1000 Authentication failed**:
#    - In Supabase: **Database → Reset database password**, then copy the new **Connection string** again.
#    - In Vercel: update **DATABASE_URL** (and **DIRECT_URL** if set), **Save**, then **Redeploy**.
# 5) **Transaction pooler (port 6543)** strings from Supabase often use user **`postgres.<project-ref>`** exactly as shown.
#    Do not swap in a random username; copy the full URI from **Connect → Transaction pooler**.
# 6) If **DATABASE_URL** uses the **transaction** pooler (6543), set **DIRECT_URL** to the **Session** or **Direct**
#    URI from the same Connect screen (Prisma migrations should not use transaction mode only).
#    If you use one **direct/session** URI for everything, you can omit DIRECT_URL (build copies DATABASE_URL).
#
# For local dev / small traffic (single URI for both):
#    DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
#    DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
#    (Or the non-pooler host on 5432 from the dashboard — set DATABASE_URL and DIRECT_URL to the same string.)
#
# Run migrations: npx prisma migrate deploy   (uses DIRECT_URL when set, else DATABASE_URL via vercel-build helper)
#
# --- Neon (example) ---
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional if same as DATABASE_URL — `npm run build` / Vercel set it automatically when omitted.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js — use a long random string in production (e.g. openssl rand -base64 32)
AUTH_SECRET="use-a-long-random-string-at-least-32-chars"
AUTH_URL="http://localhost:3001"

# Google OAuth (sign-in / sign-up — only auth method).
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web).
# Authorized JavaScript origins: http://localhost:3001  and  https://YOUR_VERCEL_DOMAIN
# Authorized redirect URIs:
#   http://localhost:3001/api/auth/callback/google
#   https://YOUR_VERCEL_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (welcome email on signup): https://resend.com/api-keys
# 1) Add RESEND_API_KEY to Vercel (Production) and redeploy.
# 2) Add + verify your domain at https://resend.com/domains (DNS records).
# 3) Set RESEND_FROM to an address on that domain, e.g. "VDS <noreply@yourdomain.com>".
#    Default onboarding@resend.dev is for testing only and often will not reach real inboxes.
RESEND_API_KEY=""
RESEND_FROM="VDS <noreply@yourdomain.com>"

# OpenAI (patient chat, vocab AI, term explanations, optional debrief polish).
# Vercel: Project → Settings → Environment Variables → add for Production (and Preview if you use preview deploys).
# Name must be OPENAI_API_KEY (recommended) or OPENAI_API — then redeploy so serverless picks it up.
# If DEMO_MODE=true, routes use mocks and do not call OpenAI.
OPENAI_API_KEY=""
# OPENAI_API=""          # optional alias if you already use this name in Vercel
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# DEMO_MODE=true
