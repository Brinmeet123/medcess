generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Same as DATABASE_URL for Neon / local Postgres. If the host gives a separate URL for migrations
  // (e.g. some poolers), set DIRECT_URL to that; otherwise omit and the build script defaults it.
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String?
  username   String   @unique
  email      String   @unique
  password   String
  image      String?
  createdAt  DateTime @default(now())
  subscribed Boolean  @default(true)
  totalScore Int      @default(0)
  streak     Int      @default(0)

  vocab               Vocab[]
  progress            ScenarioProgress[]
  attempts            ScenarioAttempt[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Daily AI usage per actor (registered user id or `guest:<sessionId>`).
/// Counters reset when `lastResetDate` (local calendar day) changes on the next AI request.
model UserAITokenUsage {
  id                 String    @id @default(cuid())
  userId             String    @unique
  /// Legacy UTC/date bucket; optional after local-daily migration.
  date               DateTime? @db.Date
  tokensUsed         Int       @default(0)
  requestCount       Int       @default(0)
  /// Patient-chat AI replies only (presets/cache do not increment).
  patientChatAiCount Int       @default(0)
  /// Local calendar day `YYYY-MM-DD` when usage was last reset.
  lastResetDate      String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([date])
  @@index([lastResetDate])
}

/// Per-scenario learned patient replies (AI-generated once, reused for similar questions).
model PatientLearnedResponse {
  id                 String   @id @default(cuid())
  scenarioId         String
  question           String
  normalizedQuestion String
  keywords           String[]
  response           String
  source             String   @default("ai_generated")
  usageCount         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([scenarioId, normalizedQuestion])
  @@index([scenarioId])
  @@index([usageCount(sort: Desc)])
}

model Vocab {
  id         String   @id @default(cuid())
  term       String
  definition String
  userId     String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, term])
}

/// Globally shared medical vocabulary cache (AI-generated or manually curated).
model SharedVocab {
  id               String   @id @default(cuid())
  term             String
  normalizedTerm   String   @unique
  definition       String
  simpleDefinition String
  category         String?
  source           String   @default("ai_generated")
  usageCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([usageCount(sort: Desc)])
}

model ScenarioAttempt {
  id         String   @id @default(cuid())
  userId     String
  scenarioId String
  score      Int?
  feedback   String?
  rubric     Json?
  status     String
  messages   Json?
  state      Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeForProgress ScenarioProgress?

  @@index([userId, scenarioId])
}

model ScenarioProgress {
  id              String   @id @default(cuid())
  scenarioId      String
  score           Int?
  status          String
  userId          String
  activeAttemptId String?  @unique
  updatedAt       DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeAttempt ScenarioAttempt? @relation(fields: [activeAttemptId], references: [id], onDelete: SetNull)

  @@unique([userId, scenarioId])
}
